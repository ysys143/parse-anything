# baidu/Unlimited-OCR served via vLLM (its arch IS recognized on vllm-openai:latest with
# --trust-remote-code; the remote modeling code just needs a couple extra deps). This replaces the
# native transformers/flash-attn path (flash-attn had no torch2.6 wheel).
#   docker build -t pa-ocr/unlimited -f docker/Dockerfile.unlimited .
FROM vllm/vllm-openai:latest
RUN python3 -m pip install --no-cache-dir addict matplotlib einops easydict

# Custom image for baidu/Unlimited-OCR (DeepSeek-OCR lineage, transformers model.infer()).
# Wraps the native inference API behind OpenAI /v1 via native_wrapper.py, so the shim treats it
# exactly like a vLLM server. Build context = the harness dir (COPY paths are relative to it).
#   docker build -t pa-ocr/native-unlimited -f docker/Dockerfile.native .
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
# jammy base ships python3.10 (no python3.12 package); 3.10 runs torch2.10/transformers4.57 fine.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip git ninja-build && \
    rm -rf /var/lib/apt/lists/*

# Torch first (cu128 wheels), then the pinned stack from the model card research.
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 \
        --index-url https://download.pytorch.org/whl/cu128 && \
    python3 -m pip install --no-cache-dir \
        transformers==4.57.1 pillow==12.1.1 einops==0.8.2 addict==2.4.0 easydict==1.13 pymupdf==1.27.2.2
# flash-attn 2 (deepencoder imports it); --no-build-isolation uses the torch already installed.
RUN python3 -m pip install --no-cache-dir flash-attn==2.7.3 --no-build-isolation

WORKDIR /app
COPY native_wrapper.py /app/native_wrapper.py
COPY models.json /app/models.json

ENTRYPOINT ["python3", "/app/native_wrapper.py"]

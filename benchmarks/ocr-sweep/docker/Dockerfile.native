# Custom image for baidu/Unlimited-OCR (DeepSeek-OCR lineage, transformers model.infer / infer_multi).
# Wraps the native inference API behind OpenAI /v1 via native_wrapper.py, so the shim/prewarm treat it
# exactly like a vLLM server. ONE image serves BOTH variants — the registry id selects the path:
#   baidu/Unlimited-OCR         -> per-page  (model.infer, 1 image/request)
#   baidu/Unlimited-OCR__multi  -> whole-doc (model.infer_multi, all pages in 1 request)
# Build context = the harness dir (COPY paths are relative to it).
#   docker build -t pa-ocr/unlimited-native -f docker/Dockerfile.native .
FROM nvidia/cuda:12.9.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
# jammy ships python3.10 (runs torch2.10 / transformers4.57 fine).
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip git && \
    rm -rf /var/lib/apt/lists/*

# Model card: torch 2.10.0 / transformers 4.57.1 / CUDA 12.9+.
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir torch==2.10.0 torchvision \
        --index-url https://download.pytorch.org/whl/cu129 && \
    python3 -m pip install --no-cache-dir \
        transformers==4.57.1 pillow einops addict easydict pymupdf matplotlib

# Whole-doc runs eager attention at image_size=640 (models.json infer_kwargs) so the 46-page/32k-ctx
# attention matrix fits the L4's 24GB. flash_attention_2 (faster + allows image_size=1024) is the
# intended path but has NO torch2.10 prebuilt wheel and the source compile OOMs the 32GB builder at
# MAX_JOBS>=4; to enable it, add `ENV MAX_JOBS=2` + `RUN pip install --no-build-isolation flash-attn`
# here (a ~40min build) and set NATIVE_ATTN_IMPL=flash_attention_2.
ENV PYTORCH_ALLOC_CONF=expandable_segments:True

WORKDIR /app
COPY native_wrapper.py /app/native_wrapper.py
COPY models.json /app/models.json

ENTRYPOINT ["python3", "/app/native_wrapper.py"]

    "testCommand": "cd /Users/jaesolshin/Documents/GitHub/odl-vl\nDIR=$(dirname \"$(find .local/workspace/csnl-full -name document.md 2>/dev/null | head -1)\")\nuv run --no-sync python - \"$DIR\" <<'PY' 2>&1 | grep -ivE \"SLF4J|picked\"\nimport re,sys; sys.path.insert(0,\"src\")\nfrom odl_vl.pipeline.output import _escape_currency\nDIR=sys.argv[1]; md=open(f\"{DIR}/document.md\").read()\nout=_escape_currency(md); open(f\"{DIR}/document.md\",\"w\").write(out)\nblocks=re.split(r\"\\n\\n+\", out)\nprint(\"홀수 $ 블록 (0이어야):\", [k for k,b in enumerate(blocks) if b.count('$')%2])\nprint(\"'\\\\$10/h' 이스케이프됨:\", \"\\\\$10/h\" in out, \"| 수식 '$5 \\\\times' 보존:\", \"$5 \\\\times\" in out)\nPY\n# 테스트 추가\nxattr -c tests/test_pipeline_figcaption.py 2>/dev/null\ncat >> tests/test_pipeline_figcaption.py <<'PY'\n\n\ndef test_escapes_currency_dollar_but_not_math():\n    from odl_vl.pipeline.output import _escape_currency\n    assert _escape_currency(\"paid $10/h.\") == \"paid \\\\$10/h.\"\n    assert _escape_currency(\"cost $1,000.50 total\") == \"cost \\\\$1,000.50 total\"\n    assert _escape_currency(\"was $5 \\\\times 2\") == \"was $5 \\\\times 2\"      # math token kept\n    assert _escape_currency(\"$B_t$ and $m'_t$\") == \"$B_t$ and $m'_t$\"       # math kept\nPY\nuv run --no-sync python -m pytest tests/ -q 2>&1 | tail -2",
